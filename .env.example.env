# =============================================================================
# .env.example — HackHub configurazione ambiente
# Copia in .env e compila i valori. Non committare mai il .env reale!
# =============================================================================

# ── DATABASE ──────────────────────────────────────────────────────────────────
DB_NAME=hackhub
DB_USERNAME=hackhub
# PROD: usa una password forte, mai "hackhub"
DB_PASSWORD=hackhub

# ── JWT ───────────────────────────────────────────────────────────────────────
# PROD: stringa casuale di almeno 64 caratteri
# Genera con: openssl rand -base64 64
JWT_SECRET=cambia-questa-chiave-in-produzione-minimo-64-caratteri-obbligatori!!
JWT_EXPIRATION=86400000

# ── CORS ──────────────────────────────────────────────────────────────────────
# Dev: http://localhost:4200
# Prod: https://tuodominio.com  (virgola-separato per più origini)
ALLOWED_ORIGINS=http://localhost:4200

# ── PROFILO SPRING ────────────────────────────────────────────────────────────
# dev  → ddl-auto=update, Flyway OFF, show-sql ON
# prod → ddl-auto=validate, Flyway ON, show-sql OFF
SPRING_PROFILES_ACTIVE=dev

# ── TLS (solo prod) ───────────────────────────────────────────────────────────
# Percorso locale della directory contenente fullchain.pem e privkey.pem
# Esempio con Certbot: /etc/letsencrypt/live/tuodominio.com
TLS_CERT_DIR=./certs
